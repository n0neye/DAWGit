* text=auto

# Ableton Live sets are gzip-compressed XML
*.als binary
*.alc binary
*.adg binary
*.adv binary

# Audio fixtures via LFS
*.wav filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ico binary
*.gz binary

# gofmt requires LF
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
